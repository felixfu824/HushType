/* Complete first-created dictionary.txt starter document. Comment prose is localized; executable example lines, separators, case examples, product/proper names, and syntax remain byte-semantic equivalents. */

"template.dictionary.starter_document" = "# HushType Customized Dictionary\n# =============================\n#\n# One rule per line, in this format:\n#\n#     what you say  ->  what gets typed\n#\n# Use this to fix recurring transcription errors: proper nouns the\n# speech model always mishears, acronyms that come out spelled out,\n# technical terms with non-standard phonetics, etc.\n#\n# Rules:\n#   • Lines starting with #  are comments (ignored)\n#   • Blank lines are ignored\n#   • Source is CASE-INSENSITIVE: \"cloud code\", \"Cloud Code\", and\n#     \"CLOUD CODE\" all match the same rule. The target is inserted\n#     literally, so the output always matches what you wrote.\n#   • Plain string match only; no regex, no wildcards\n#   • Longest match wins when rules overlap\n#   • Changes take effect on the next transcription (no restart)\n#\n# ---------------------------------------------------------------\n# Examples (delete the # at the start of a line to activate it)\n# ---------------------------------------------------------------\n\n# Proper nouns the model mis-transcribes:\n# 拍粉       -> Python\n# Cloud code -> Claude Code\n# Enfropic   -> Anthropic\n\n# Acronym normalization:\n# U I U X    -> UI/UX\n\n# Technical jargon:\n# J.S.O.N    -> JSON\n\n# ---------------------------------------------------------------\n# Your entries below:\n# ---------------------------------------------------------------\n";

/* Complete first-created polish_rules.txt starter document. Commented examples become model instructions if uncommented, so their behavioral meaning is preserved exactly. Service name uses its localized ServicesMenu value. */

"template.polish_rules.starter_document" = "# HushType Polish Instructions\n# ============================\n#\n# Extra instructions for Text Polish (double-tap Right Option, or\n# right-click → Services → \"Polish with HushType\").\n#\n# These are ADDED to HushType's built-in proofreading rules; the\n# built-ins stay active: fix-only proofreading, preserve meaning and\n# language mix, never answer or translate the selection.\n#\n# Rules:\n#   • Lines starting with # are comments (ignored)\n#   • Keep each instruction short and imperative; the on-device\n#     model is small, so a few clear rules work better than many\n#   • Changes take effect on the next polish (no restart needed)\n#\n# ---------------------------------------------------------------\n# Examples (delete the # at the start of a line to activate it)\n# ---------------------------------------------------------------\n#\n# Always use the Oxford comma.\n# Prefer Taiwan Mandarin word choices (寫成「計程車」，不要「出租車」).\n# Keep words in ALL CAPS exactly as typed.\n# Do not change line breaks.\n#\n# ---------------------------------------------------------------\n# Your instructions below:\n# ---------------------------------------------------------------\n";

/* live_caption.json _comment_about value; JSON key prefix remains exact. */

"template.live_caption.about" = "HushType: Live Caption tunables. Edit values then toggle Live Caption off and on for changes to apply. Keys prefixed _comment_ are documentation only and are ignored by the parser.";

/* live_caption.json documentation; technical terms and exact numeric semantics remain. */

"template.live_caption.max_tokens" = "ASR decoder max generated tokens per segment. Larger budgets cost more decoder KV cache per call and risk runaway generation past EOS. Speech-swift default is 448, validated stable on the 15-min long session test. Bumping past 1024 has been observed to push unified memory off a cliff.";

/* live_caption.json technical documentation; preserve units and values. */

"template.live_caption.mlx_cache" = "MLX GPU buffer pool cap in MB. Lower = less RAM but cold transcribes; higher = warm cache. 128 was too tight; 1024 is the perf-tuned default on Apple Silicon. Drop to 256 or 512 if you want a tighter RAM ceiling.";

/* live_caption.json VAD threshold documentation. */

"template.live_caption.vad_thresholds" = "VAD probability thresholds to enter and exit speech state (0.0-1.0). Silero defaults 0.5 / 0.35. Lower onset = more sensitive (more fragments in noisy rooms).";

/* live_caption.json VAD duration documentation; JSON concepts and exact defaults remain. */

"template.live_caption.vad_durations" = "minSpeech: how long confirmed speech must run before a segment can be emitted. minSilence: how much pause closes a segment. Both in seconds. Silero defaults 0.25 / 0.10.";

/* live_caption.json force-split documentation. */

"template.live_caption.force_split" = "Force-split a continuous monologue at this duration (seconds). Spec default 10.";

/* live_caption.json backpressure documentation. Source contains 'first-cold'; translated by intended literal technical meaning and flagged for English cleanup review. */

"template.live_caption.backpressure" = "Drop new audio buffers when more than this many feeds are pending at the worker actor. 50 ≈ 2 s of audio, enough room for the first cold transcription without unbounded queueing.";

/* live_caption.json protocol-value documentation; mic/system remain exact. */

"template.live_caption.audio_source" = "Source for Live Caption: 'mic' or 'system'. Defaults to 'mic'. Switch via menu (Live Caption submenu) or by editing here + toggling Live Caption off/on. The menu always wins on conflict.";

