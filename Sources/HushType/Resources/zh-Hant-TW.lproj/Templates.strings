"template.polish_rules.starter_document" = "# HushType 校對指示\n# ==================\n#\n# 文字校對的額外指示（連按兩下右側 Option，或\n# 按右鍵 → 服務 →「使用 HushType 校對」）。\n#\n# 這些指示會加入 HushType 的內建校對規則；內建規則仍會生效：\n# 僅修正錯誤、保留原意與語言混用，絕不回答或翻譯選取的內容。\n#\n# 規則：\n#   • 以 # 開頭的行是註解（會忽略）\n#   • 每條指示請保持簡短並使用祈使句；裝置上的模型較小，\n#     少量清楚的規則會比大量規則更有效\n#   • 變更會在下一次校對時生效（不需重新啟動）\n#\n# ---------------------------------------------------------------\n# 範例（刪除行首的 # 即可啟用）\n# ---------------------------------------------------------------\n#\n# 一律使用 Oxford comma。\n# 偏好台灣華語用詞（寫成「計程車」，不要「出租車」）。\n# 完全依照輸入保留 ALL CAPS 的文字。\n# 不要變更換行。\n#\n# ---------------------------------------------------------------\n# 請在下方加入你的指示：\n# ---------------------------------------------------------------\n";

/* live_caption.json _comment_about value; JSON key prefix remains exact. */

"template.live_caption.about" = "HushType：即時字幕可調整參數。編輯數值後，關閉再開啟即時字幕即可套用變更。以 _comment_ 開頭的鍵僅供說明，解析器會忽略。";

/* live_caption.json documentation; technical terms and exact numeric semantics remain. */

"template.live_caption.max_tokens" = "每個區段的 ASR 解碼器最大產生 token 數。額度越大，每次呼叫會使用越多解碼器 KV cache，並可能在 EOS 後持續失控產生內容。Speech-swift 預設值為 448，已在 15 分鐘長時間工作階段測試中驗證穩定。觀察到提高至 1024 以上時，統一記憶體用量會急遽增加。";

/* live_caption.json technical documentation; preserve units and values. */

"template.live_caption.mlx_cache" = "MLX GPU 緩衝池上限（MB）。較低 = RAM 使用量較少，但每次轉錄都需冷啟動；較高 = 使用暖快取。128 太低；1024 是針對 Apple Silicon 效能調校的預設值。若要更嚴格限制 RAM，可降至 256 或 512。";

